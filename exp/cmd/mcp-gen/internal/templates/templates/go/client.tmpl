// GetAvailableTools returns the server tools.
func (c *{{.Client.Name}}) GetAvailableTools(ctx context.Context) ([]*mcp.Tool, error) {
	if c.session == nil { return nil, fmt.Errorf("client is not initialized") }
	result, err := c.session.ListTools(ctx, nil)
	if err != nil { return nil, fmt.Errorf("list tools: %w", err) }
	return result.Tools, nil
}

// GetServerInfo returns the server capabilities from initialization.
func (c *{{.Client.Name}}) GetServerInfo(ctx context.Context) (*mcp.ServerCapabilities, error) {
	if c.session == nil { return nil, fmt.Errorf("client is not initialized") }
	return c.session.InitializeResult().Capabilities, nil
}

// Ping checks the connection using the MCP ping method.
func (c *{{.Client.Name}}) Ping(ctx context.Context) error {
	if c.session == nil { return fmt.Errorf("client is not initialized") }
	return c.session.Ping(ctx, nil)
}

// WithTimeout creates a context with the specified timeout.
func (c *{{.Client.Name}}) WithTimeout(timeout time.Duration) (context.Context, context.CancelFunc) {
	return context.WithTimeout(context.Background(), timeout)
}

// WithDeadline creates a context with the specified deadline.
func (c *{{.Client.Name}}) WithDeadline(deadline time.Time) (context.Context, context.CancelFunc) {
	return context.WithDeadline(context.Background(), deadline)
}

// HealthCheck checks the connection and server tools.
func (c *{{.Client.Name}}) HealthCheck(ctx context.Context) error {
	if err := c.Ping(ctx); err != nil { return fmt.Errorf("ping: %w", err) }
	tools, err := c.GetAvailableTools(ctx)
	if err != nil { return fmt.Errorf("list tools: %w", err) }
	available := make(map[string]bool, len(tools))
	for _, tool := range tools { if tool != nil { available[tool.Name] = true } }
	for _, name := range []string{ {{range .Tools}}"{{.Name}}",{{end}} } {
		if !available[name] { return fmt.Errorf("expected tool %s is unavailable", name) }
	}
	return nil
}

// IsConnected reports whether the server responds to ping.
func (c *{{.Client.Name}}) IsConnected(ctx context.Context) bool { return c.Ping(ctx) == nil }

// GetClient returns the active client session.
func (c *{{.Client.Name}}) GetClient() *mcp.ClientSession { return c.session }
