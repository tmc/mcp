// {{.Client.Name}} provides a client for the MCP server.
type {{.Client.Name}} struct {
	transport mcp.Transport
	client *mcp.Client
	session *mcp.ClientSession
}

// New{{.Client.Name}} creates a client for transport.
func New{{.Client.Name}}(transport mcp.Transport) (*{{.Client.Name}}, error) {
	if transport == nil { return nil, fmt.Errorf("transport is required") }
	return &{{.Client.Name}}{transport: transport}, nil
}

// Initialize connects to the MCP server.
func (c *{{.Client.Name}}) Initialize(ctx context.Context, clientInfo mcp.Implementation) error {
	if c.session != nil { return fmt.Errorf("client is already initialized") }
	c.client = mcp.NewClient(&clientInfo, nil)
	session, err := c.client.Connect(ctx, c.transport, nil)
	if err != nil { return fmt.Errorf("connect to server: %w", err) }
	c.session = session
	return nil
}

// Close closes the client session.
func (c *{{.Client.Name}}) Close() error {
	if c.session == nil { return nil }
	return c.session.Close()
}

